# Evolution API Configuration
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=http://13.140.151.85:8081

# Database Configuration
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://whatsapp:whatsapp_password@db:5432/whatsapp_bot?sslmode=disable
DATABASE_CONNECTION_CLIENT_NAME=evolution_api

# WhatsApp Community Fixes for Pairing
CONFIG_SESSION_PHONE_CLIENT=MorningStar
CONFIG_SESSION_PHONE_VERSION=2.3000.1033773198

# Redis Configuration (Disabled for stability during pairing)
REDIS_ENABLED=false
CACHE_REDIS_ENABLED=false

# Ollama & Evolution internal URLs
OLLAMA_URL=http://host.docker.internal:11434
EVOLUTION_URL=http://evolution-api:8080

# Webhook Configuration
WEBHOOK_GLOBAL_ENABLED=true
WEBHOOK_GLOBAL_URL=http://brain:3000/webhook
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false

# WebSocket Configuration
WEBSOCKET_ENABLED=true
WEBSOCKET_GLOBAL_EVENTS=true

# CORS Configuration
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_CREDENTIALS=true
WEBHOOK_EVENTS_APPLICATION_STATUS_UPDATE=true
WEBHOOK_EVENTS_QRCODE_UPDATED=true
WEBHOOK_EVENTS_MESSAGES_SET=true
WEBHOOK_EVENTS_MESSAGES_UPSERT=true
WEBHOOK_EVENTS_MESSAGES_UPDATE=true
WEBHOOK_EVENTS_SEND_MESSAGE=true
WEBHOOK_EVENTS_CONTACTS_SET=true
WEBHOOK_EVENTS_CONTACTS_UPSERT=true
WEBHOOK_EVENTS_CONTACTS_UPDATE=true
WEBHOOK_EVENTS_PRESENCE_UPDATE=true
WEBHOOK_EVENTS_CHATS_SET=true
WEBHOOK_EVENTS_CHATS_UPSERT=true
WEBHOOK_EVENTS_CHATS_UPDATE=true
WEBHOOK_EVENTS_CHATS_DELETE=true
WEBHOOK_EVENTS_GROUPS_UPSERT=true
WEBHOOK_EVENTS_GROUPS_UPDATE=true
WEBHOOK_EVENTS_GROUP_PARTICIPANTS_UPDATE=true
WEBHOOK_EVENTS_CONNECTION_UPDATE=true
WEBHOOK_EVENTS_CALL=true
WEBHOOK_EVENTS_TYPEBOT_UNKNOWN=true
WEBHOOK_EVENTS_TYPEBOT_CHANGE_STATUS=true
WEBHOOK_EVENTS_CHATWOOT_MESSAGE_DELETE=true

# Authentication
AUTHENTICATION_TYPE=apikey
AUTHENTICATION_API_KEY=morningstar_secret_key
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# Language
LANGUAGE=fr-FR
INSTANCE_NAME=Poulga
OLLAMA_KEEP_ALIVE=24h
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_ENABLED=false
CACHE_REDIS_ENABLED=false
DASHBOARD_ENABLED=true
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=admin
