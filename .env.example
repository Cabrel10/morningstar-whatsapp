# Evolution API Configuration
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=http://your-ip-or-domain:8081

# Database Configuration
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://whatsapp:whatsapp_password@db:5432/whatsapp_bot?sslmode=disable
DATABASE_CONNECTION_CLIENT_NAME=evolution_api

# Redis Configuration
REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PREFIX_KEY=evolution
CACHE_REDIS_ENABLED=false

# Ollama & Evolution internal URLs
OLLAMA_URL=http://host.docker.internal:11434
EVOLUTION_URL=http://evolution-api:8080
OLLAMA_KEEP_ALIVE=24h

# Authentication
AUTHENTICATION_TYPE=apikey
AUTHENTICATION_API_KEY=morningstar_secret_key
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# Webhook Configuration
WEBHOOK_GLOBAL_ENABLED=true
WEBHOOK_GLOBAL_URL=http://brain:3000/webhook
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false

# Language & Instance
LANGUAGE=fr-FR
INSTANCE_NAME=Poulga

# Dashboard
DASHBOARD_ENABLED=true
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=admin
